# Copy this file to .env. Never commit the actual .env file.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# HTTPS origins, separated by commas, when using a deployed domain.
DJANGO_CSRF_TRUSTED_ORIGINS=

# sqlite preserves local data. Set mysql after installing requirements-mysql.txt.
DB_ENGINE=sqlite
DB_NAME=irish_store
DB_USER=irish_app
# Use a quoted value if your password contains # or spaces.
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
